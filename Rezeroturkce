function parseNovelDetails(novelUrl)
    local novel = {}
    local response = getPageWithBypass(novelUrl)
    local soup = bsu.parse(response)
    
    novel.title = soup:find("h1"):text() or "Özel Kitap"
    novel.chapters = {}
    
    -- Sitedeki tüm sekmeleri/bölüm linklerini otomatik toplar
    for _, a in ipairs(soup:findAll("a")) do
        local href = a:attr("href")
        if href and (href:find("bolum") or href:find("chapter") or href:find("/p/")) then
            table.insert(novel.chapters, {
                title = a:text():trim(),
                url = url.absolute(novelUrl, href)
            })
        end
    end
    return novel
end

function parseChapterDetails(chapterUrl)
    local chapter = {}
    local response = getPageWithBypass(chapterUrl)
    local soup = bsu.parse(response)
    
    -- Sayfadaki tüm paragrafları (<p> etiketlerini) temizce ePub'ın içine gömer
    local paragraphs = {}
    for _, p in ipairs(soup:findAll("p")) do
        table.insert(paragraphs, p:text():trim())
    end
    
    chapter.content = table.concat(paragraphs, "\n\n")
    return chapter
end
